# Copy this file to `.env.local` and fill in your own key.
#   cp .env.example .env.local
#
# Get a key at https://openrouter.ai/keys
#
# SECURITY: Vite inlines this value into the client bundle at build time, so the
# key is visible to anyone who can load the page. Run ReceiptBench locally only, and
# never deploy a build of it to a public URL. Use a key with a low spend limit.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
